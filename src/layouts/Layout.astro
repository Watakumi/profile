---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Watakumi のプロフィールページ。ブラウザで完結する小さくて楽しい個人アプリを量産中。',
} = Astro.props;
---

<!doctype html>
<html lang='ja'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <meta name='description' content={description} />
    <meta name='theme-color' content='#7c3aed' />
    <title>{title}</title>
    <meta property='og:type' content='website' />
    <meta property='og:title' content='Watakumi Page' />
    <meta property='og:description' content={description} />
    <meta property='og:url' content='https://watakumi.page' />
    <meta property='og:image' content='https://watakumi.page/ogp.png' />
    <meta name='twitter:card' content='summary_large_image' />
  </head>
  <body>
    <slot />
  </body>
</html>
