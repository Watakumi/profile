---
import type { SkillGroup } from '../data/profile';

type Props = {
  groups: SkillGroup[];
};

const { groups } = Astro.props;
---

<section class='mt-12 rise' style='animation-delay: 0.1s'>
  <h2 class='flex items-center gap-2 text-2xl font-extrabold'>
    <span aria-hidden='true'>🧰</span>Skills
  </h2>
  {
    groups.map((group) => (
      <div class='mt-6'>
        <h3 class='flex items-center gap-2 text-sm font-bold tracking-wide text-ink/60 uppercase dark:text-white/50'>
          <span aria-hidden='true'>{group.emoji}</span>
          {group.label}
        </h3>
        <ul class='mt-3 flex flex-wrap gap-2.5'>
          {group.items.map((item) => {
            const inner = (
              <>
                <span class='h-2.5 w-2.5 rounded-full' style='background:var(--dot)' />
                {item.name}
              </>
            );
            const cls =
              'chip inline-flex items-center gap-2 rounded-2xl border border-white/70 bg-white/80 px-3.5 py-2 text-sm font-bold text-ink shadow-sm backdrop-blur transition-all duration-300 dark:border-white/10 dark:bg-white/10 dark:text-white';
            return (
              <li>
                {item.src ? (
                  <a
                    href={item.src}
                    target='_blank'
                    rel='noopener noreferrer'
                    class={`${cls} group hover:-translate-y-1 hover:shadow-lg`}
                    style={`--dot:${group.color}`}
                  >
                    {inner}
                    <span class='text-ink/40 transition-transform duration-300 group-hover:translate-x-0.5 dark:text-white/40'>
                      →
                    </span>
                  </a>
                ) : (
                  <span class={cls} style={`--dot:${group.color}`}>
                    {inner}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .chip {
    position: relative;
  }
  .chip::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    padding: 1.5px;
    background: linear-gradient(120deg, var(--dot), transparent 70%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .chip:hover::after {
    opacity: 1;
  }
</style>
