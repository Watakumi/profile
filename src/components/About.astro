---
import { about } from '../data/profile';
---

<section class='mt-12 rise' style='animation-delay: 0.05s'>
  <h2 class='flex items-center gap-2 text-2xl font-extrabold'>
    <span aria-hidden='true'>🧑‍💻</span>About
  </h2>
  <div
    class='mt-4 rounded-3xl border border-white/70 bg-white/80 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/10'
  >
    <p class='leading-loose text-ink/80 dark:text-white/75'>{about}</p>
  </div>
</section>
