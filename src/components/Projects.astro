---
import Project from './Project.astro';
import type { Project as ProjectType } from '../data/profile';

export type Props = {
  projects: ProjectType[];
};

const { projects } = Astro.props;
---

<section class='mt-12 rise' style='animation-delay: 0.3s'>
  <h2 class='flex items-center gap-2 text-2xl font-extrabold'>
    <span aria-hidden='true'>🚀</span>Projects
  </h2>
  <ul class='mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2'>
    {projects.map((project) => <Project {...project} />)}
  </ul>
</section>
