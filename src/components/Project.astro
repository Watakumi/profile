---
import type { Project } from '../data/profile';

type Props = Project;

const { name, description, emoji, theme, src } = Astro.props;
const isLive = src !== '#';
---

<li class={`grad-${theme} h-full`}>
  <a
    href={src}
    target={isLive ? '_blank' : undefined}
    rel={isLive ? 'noopener noreferrer' : undefined}
    aria-disabled={!isLive}
    class='card group relative flex h-full flex-col gap-3 rounded-3xl border border-white/70 bg-white/85 p-5 shadow-sm backdrop-blur transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl dark:border-white/10 dark:bg-white/10'
  >
    <div class='flex items-start justify-between gap-2'>
      <span
        class='grid h-12 w-12 place-items-center rounded-2xl text-2xl shadow-inner'
        style='background:linear-gradient(135deg, color-mix(in srgb, var(--g1) 22%, white), color-mix(in srgb, var(--g2) 22%, white))'
        aria-hidden='true'>{emoji}</span>
      <span
        class={`rounded-full px-2.5 py-1 text-xs font-bold ${
          isLive
            ? 'bg-green/15 text-emerald-700 dark:text-emerald-300'
            : 'bg-ink/10 text-ink/50 dark:bg-white/10 dark:text-white/40'
        }`}
      >
        {isLive ? 'LIVE' : 'Coming soon'}
      </span>
    </div>

    <h3
      class='text-lg font-extrabold text-ink transition-colors group-hover:text-transparent group-hover:[background-image:linear-gradient(100deg,var(--g1),var(--g2))] group-hover:[background-clip:text] group-hover:[-webkit-background-clip:text] dark:text-white'
    >
      {name}
    </h3>
    <p class='text-sm leading-relaxed text-ink/70 dark:text-white/60'>
      {description}
    </p>

    <span
      class='mt-auto inline-flex items-center gap-1 text-sm font-bold text-ink/50 transition-all group-hover:gap-2 group-hover:text-ink dark:text-white/50 dark:group-hover:text-white'
    >
      {isLive ? '見てみる' : '準備中'}
      {isLive && <span class='transition-transform group-hover:translate-x-1'>→</span>}
    </span>
  </a>
</li>

<style>
  .card {
    position: relative;
    overflow: hidden;
  }
  /* 上辺のグラデーションライン */
  .card::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--g1), var(--g2));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover::before {
    transform: scaleX(1);
  }
</style>
