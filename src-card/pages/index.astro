---
import Layout from '../../src/layouts/Layout.astro';
import BusinessCard from '../components/BusinessCard.astro';
import { card } from '../../src/data/card';
import { links } from '../../src/data/profile';

// 名前・肩書き・スキルは OGP 画像側に出ているので、説明文では繰り返さない。
// 画像が伝えられないこと（めくれる・連絡先に追加できる）だけを書く。
const description = 'めくるとスキルと連絡先。そのまま端末に追加できます。';

// 名刺専用の OGP 画像。src-card/pages/ogp-preview.astro を
// ヘッドレス Chrome で 1200x630 撮影して生成しています（再生成手順はそのファイル冒頭）。
const ogImage = `${card.cardUrl}/ogp-card.png`;

// 2つのドメインが同一人物であることを検索エンジンに伝える
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: card.name,
  url: card.cardUrl,
  jobTitle: card.role,
  image: `${card.cardUrl}/avatar.png`,
  description: card.specialty,
  sameAs: [card.siteUrl, ...links.map((l) => l.src)],
};
---

<Layout
  title={`${card.name} | Digital Card`}
  description={description}
  ogTitle={`${card.name} | Digital Card`}
  ogUrl={card.cardUrl}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <main>
    <BusinessCard />
  </main>
</Layout>
